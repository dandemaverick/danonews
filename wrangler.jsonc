{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "danonews",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "danonews-db",
    "database_id": "c988c152-0fd9-4ccd-bc12-be9f8a86fbac",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "danonews-images"}],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": ""
  }
}
